# Local Postgres, or your Supabase connection string (Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Set by Render automatically in production; only needed locally if you want a non-default port
PORT=4000

# Set to "production" on Render so the Postgres client uses SSL (required by Supabase)
NODE_ENV=development

# Comma-separated list of allowed frontend origins in production, e.g. https://fitly-frontend.pages.dev
# Leave unset locally to allow any origin.
CORS_ORIGIN=

# Public URL of this API, used as the Swagger "server" address. Leave unset locally.
API_BASE_URL=
